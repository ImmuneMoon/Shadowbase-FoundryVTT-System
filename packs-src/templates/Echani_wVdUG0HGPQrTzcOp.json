      "_key": "!actors.items!wVdUG0HGPQrTzcOp.MlA477qhsWabhPxo",
      "name": "Read Opponent (Echani)",
      "type": "advantage",
      "img": "icons/svg/upgrade.svg",
      "sort": 800000,
      "system": {
        "row": {
          "name": "Read Opponent (Echani)",
          "points": 0,
          "description": "Echani can instinctively \"read\" an opponent's fighting style, emotions, and intentions through their movements. This grants a +1 bonus to Evaluate maneuvers used against a sentient opponent. When successful, the Echani gains a +1 bonus to all Active Defenses against that specific opponent for the next turn, representing their ability to predict and counter attacks. This analytical approach to combat removes sentiment, making them coldly efficient in dispatching foes. Cost: 1 point (Perk).",
          "level": null,
          "category": "Racial",
          "baselinePoints": 0,
          "fromSpecies": "Echani"
        },
        "source": "advantages"
      },
      "effects": [],
      "flags": {}
