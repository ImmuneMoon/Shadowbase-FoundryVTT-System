  "items": [
    {
      "_id": "Q1M7pJqaazV0tBen",
      "_key": "!actors.items!weO7R4zZV23zaAyR.Q1M7pJqaazV0tBen",
      "name": "Danger Sense",
      "type": "advantage",
      "img": "icons/svg/upgrade.svg",
      "sort": 100000,
      "system": {
        "row": {
          "name": "Danger Sense",
          "points": 15,
          "description": "You possess an instinctive ability to detect impending threats or danger. The GM will secretly roll against your Perception in situations involving ambushes, disasters, or similar hazards. On a success, you receive enough warning to take action. A roll of 3 or 4 provides additional detail about the danger. This early warning system primarily serves self-preservation, allowing you to react quickly whether to save allies or simply escape a trap. (Refer to GURPS Basic Set: Characters for full details.) Note: While a general advantage, for Force-sensitives, this often manifests as a subtle Force premonition. Prerequisite: Force Sensitive (if taken as a Force-related advantage, representing a Force-user's sensitivity to danger through the Force).",
          "level": null,
          "category": "Mental",
          "baselinePoints": 15
        },
        "source": "advantages"
      },
      "effects": [],
      "flags": {}
    },
    {
      "_id": "MglqobL35wcc7Mqh",
      "_key": "!actors.items!weO7R4zZV23zaAyR.MglqobL35wcc7Mqh",
      "name": "Field Detection (Miraluka)",
      "type": "advantage",
      "img": "icons/svg/upgrade.svg",
      "sort": 200000,
      "system": {
        "row": {
          "name": "Field Detection (Miraluka)",
          "points": 0,
          "description": "Miraluka's intrinsic connection to the Force grants them an exceptional ability to perceive, analyze, and interact with energy fields. When a Miraluka character attempts a skill check to perceive, analyze, or interact with an energy field, their Field Detection ability grants them a significant mechanical advantage. Grant a +3 to +5 bonus to the Miraluka's relevant skill roll (e.g., Perception, Electronics Operation, Energy Weapon (Beam), or a specialized Force-related skill) when they are actively using Field Detection in an appropriate scenario. The specific bonus can be adjusted by the GM based on the complexity of the task or the Miraluka's Force sensitivity. This ability makes them expert saboteurs, security bypassers, or mechanics, capable of manipulating energy systems for various ends. Cost range: 5 points (Basic).",
          "level": null,
          "category": "Racial",
          "baselinePoints": 0
        },
        "source": "advantages"
      },
      "effects": [],
      "flags": {}
    },
    {
