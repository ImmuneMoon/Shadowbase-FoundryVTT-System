<!-- systems\shadowbase\templates\partials\inventory\actor-weapons-list.hbs -->

<div class="section-box">
  <h3 class="section-header collapsible-header">
      <span><i class="fas fa-chevron-down"></i> Weapons </span>
  </h3>
  {{#if inventory.weapons}}
    <ul class="item-list combat-weapon-list">
      {{!-- Melee Weapons --}}
      <h4>Melee Weapons</h4>
      {{#each inventory.weapons.melee as |item id|}}
        <li class="item-entry weapon-entry" data-item-id="{{item._id}}">
          <div class="item-header">
            <span class="item-name">{{item.name}}</span>
            <div class="item-controls">
              <span class="text-xs text-muted-foreground">{{item.system.finalDamage}} {{item.system.finalDamageType}}</span>
              <button type="button" class="roll-link attack-roll-button" data-roll-type="attack" data-item-id="{{item._id}}">
                <i class="fas fa-dice-d20" title="Roll Attack"></i>
              </button>
              <button type="button" class="roll-link damage-roll-button" data-roll-type="damage" data-item-id="{{item._id}}">
                <i class="fas fa-tint" title="Roll Damage"></i>
              </button>
            </div>
          </div>
        </li>
      {{/each}}

      {{!-- Blasters --}}
      <h4 class="mt-4">Blasters</h4>
      {{#each inventory.weapons.blasters as |item id|}}
        <li class="item-entry weapon-entry" data-item-id="{{item._id}}">
          <div class="item-header">
            <span class="item-name">{{item.name}}</span>
            <div class="item-controls">
              <span class="text-xs text-muted-foreground">{{item.system.finalDamage}} {{item.system.finalDamageType}}</span>
              <button type="button" class="roll-link attack-roll-button" data-roll-type="attack" data-item-id="{{item._id}}">
                <i class="fas fa-dice-d20" title="Roll Attack"></i>
              </button>
              <button type="button" class="roll-link damage-roll-button" data-roll-type="damage" data-item-id="{{item._id}}">
                <i class="fas fa-tint" title="Roll Damage"></i>
              </button>
            </div>
          </div>
        </li>
      {{/each}}

      {{!-- Lightsabers --}}
      <h4 class="mt-4">Lightsabers</h4>
      {{#each inventory.weapons.lightsabers as |item id|}}
        <li class="item-entry weapon-entry" data-item-id="{{item._id}}">
          <div class="item-header">
            <span class="item-name">{{item.name}}</span>
            <div class="item-controls">
              <span class="text-xs text-muted-foreground">{{item.system.calculatedDamage}} {{item.system.calculatedDamageType}}</span>
              <button type="button" class="roll-link attack-roll-button" data-roll-type="attack" data-item-id="{{item._id}}">
                <i class="fas fa-dice-d20" title="Roll Attack"></i>
              </button>
              <button type="button" class="roll-link damage-roll-button" data-roll-type="damage" data-item-id="{{item._id}}">
                <i class="fas fa-tint" title="Roll Damage"></i>
              </button>
            </div>
          </div>
        </li>
      {{/each}}

      {{!-- Explosives - Assuming explosives should also be listed here --}}
      <h4 class="mt-4">Explosives</h4>
      {{#each inventory.explosives as |item id|}}
        <li class="item-entry weapon-entry" data-item-id="{{item._id}}">
          <div class="item-header">
            <span class="item-name">{{item.name}}</span>
            <div class="item-controls">
              <span class="text-xs text-muted-foreground">{{item.system.finalDamageEffect}}</span>
              <button type="button" class="roll-link damage-roll-button" data-roll-type="damage" data-item-id="{{item._id}}">
                <i class="fas fa-tint" title="Roll Damage"></i>
              </button>
            </div>
          </div>
        </li>
      {{/each}}
    </ul>
  {{/if}}
</div>