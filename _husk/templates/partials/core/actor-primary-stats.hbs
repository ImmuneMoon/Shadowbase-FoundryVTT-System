<!-- systems\shadowbase\templates\partials\core\actor-primary-stats.hbs -->
<div class="section-box">
    <h3 class="section-header">Primary Attributes</h3>
    <div class="primary-stats-grid">
        {{#each system.attributes as |attr key|}}
            <div class="attribute-block">
                <label for="system.attributes.{{key}}.value" class="attribute-label">{{capitalize key}}</label>
                <div class="attribute-value-wrapper">
                    <input type="number" name="system.attributes.{{key}}.value" value="{{attr.value}}" class="attribute-value-input" />
                    <button type="button" class="rollable rollable-attribute" data-attribute="{{key}}" title="Roll {{capitalize key}}">
                        <i class="fas fa-dice-d20"></i>
                    </button>
                </div>
                <span class="attribute-points-cost">[{{attr.points}} pts]</span>
            </div>
        {{/each}}
    </div>
</div>