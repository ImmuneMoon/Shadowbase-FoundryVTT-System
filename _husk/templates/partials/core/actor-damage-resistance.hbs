<!-- systems\shadowbase\templates\partials\core\actor-damage-resistance.hbs -->
<div class="section-box">
    <h3 class="section-header">Damage Resistance & Hit Locations</h3>
    <table class="dr-table">
        <thead>
            <tr>
                <th>Location</th>
                <th>To-Hit</th>
                <th>DR</th>
            </tr>
        </thead>
        <tbody>
            <tr><td>Head</td><td>-5</td><td><input type="number" name="system.characteristics.dr.head" value="{{system.characteristics.dr.head}}"></td></tr>
            <tr><td>Torso</td><td>0</td><td><input type="number" name="system.characteristics.dr.torso" value="{{system.characteristics.dr.torso}}"></td></tr>
            <tr><td>Left Arm</td><td>-2</td><td><input type="number" name="system.characteristics.dr.leftArm" value="{{system.characteristics.dr.leftArm}}"></td></tr>
            <tr><td>Right Arm</td><td>-2</td><td><input type="number" name="system.characteristics.dr.rightArm" value="{{system.characteristics.dr.rightArm}}"></td></tr>
            <tr><td>Left Leg</td><td>-2</td><td><input type="number" name="system.characteristics.dr.leftLeg" value="{{system.characteristics.dr.leftLeg}}"></td></tr>
            <tr><td>Right Leg</td><td>-2</td><td><input type="number" name="system.characteristics.dr.rightLeg" value="{{system.characteristics.dr.rightLeg}}"></td></tr>
            <tr><td>Left Hand</td><td>-4</td><td><input type="number" name="system.characteristics.dr.leftHand" value="{{system.characteristics.dr.leftHand}}"></td></tr>
            <tr><td>Right Hand</td><td>-4</td><td><input type="number" name="system.characteristics.dr.rightHand" value="{{system.characteristics.dr.rightHand}}"></td></tr>
            <tr><td>Left Foot</td><td>-4</td><td><input type="number" name="system.characteristics.dr.leftFoot" value="{{system.characteristics.dr.leftFoot}}"></td></tr>
            <tr><td>Right Foot</td><td>-4</td><td><input type="number" name="system.characteristics.dr.rightFoot" value="{{system.characteristics.dr.rightFoot}}"></td></tr>
        </tbody>
    </table>
</div>
