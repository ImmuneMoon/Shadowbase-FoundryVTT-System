<!-- systems\shadowbase\templates\partials\narriative\actor-notes.hbs -->
<div class="section-box">
    <h3 class="section-header">Notes & Narrative</h3>
    <div class="space-y-4">
        <div>
            <label>Description</label>
            <textarea name="system.narrative.description" rows="4">{{system.narrative.description}}</textarea>
        </div>
        <div>
            <label>Background</label>
            <textarea name="system.narrative.background" rows="6">{{system.narrative.background}}</textarea>
        </div>
        <div>
            <label>Notes</label>
            <textarea name="system.narrative.notes" rows="6">{{system.narrative.notes}}</textarea>
        </div>
    </div>
</div>