<!-- systems\shadowbase\templates\actor-sheet.hbs -->

<form class="{{cssClass}}" autocomplete="off">
    <header class="sheet-title-bar">
        <div class="header-logo">
            <img src="systems/shadowbase/assets/ShadowBase_icon.png" alt="ShadowBase Logo" width="30" height="30" />
            <span>ShadowBase</span>
        </div>
        <div class="header-button-container">
            <button type="button" class="import-json-button">
                <i class="fas fa-upload"></i> Import Character
            </button>
            <button type="button" class="export-json-button">
                <i class="fas fa-download"></i> Export Character
            </button>
            <button type="button" class="open-roll-hub">
                <i class="fas fa-dice-d20"></i> Quick Rolls
            </button>
        </div>
    </header>

    {{!-- Sheet Tab Navigation --}}
    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="core"><i class="fas fa-heartbeat"></i> Core Stats</a>
        <a class="item" data-tab="combat"><i class="fas fa-swords"></i> Combat Hub</a>
        <a class="item" data-tab="abilities"><i class="fas fa-brain"></i> Abilities</a>
        <a class="item" data-tab="inventory"><i class="fas fa-box-open"></i> Inventory</a>
        <a class="item" data-tab="narrative"><i class="fas fa-book-open"></i> Narrative</a>
    </nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">

        {{!-- Core Tab --}}
        <div class="tab" data-group="primary" data-tab="core">
            {{> "systems/shadowbase/templates/partials/core/actor-header-info.hbs" characteristics=system.characteristics details=system.details points=system.points}}
            {{> "systems/shadowbase/templates/partials/core/actor-force-alignment.hbs" system.forceAlignment}}
            {{> "systems/shadowbase/templates/partials/core/actor-primary-stats.hbs" attributes=system.attributes}}
            {{> "systems/shadowbase/templates/partials/core/actor-secondary-stats.hbs" characteristics=system.characteristics}}
            {{> "systems/shadowbase/templates/partials/core/actor-damage-resistance.hbs" dr=system.characteristics.dr}}
        </div>

        {{!-- Combat Tab --}}
        <div class="tab" data-group="primary" data-tab="combat">
            {{> "systems/shadowbase/templates/partials/combat/actor-combat-hub.hbs" characteristics=system.characteristics inventory=system.inventory}}
        </div>

        {{!-- Abilities Tab --}}
        <div class="tab" data-group="primary" data-tab="abilities">
            {{> "systems/shadowbase/templates/partials/abilities/actor-traits.hbs" traits=system.traits}}
            {{> "systems/shadowbase/templates/partials/abilities/actor-skills.hbs" skills=system.skills}}
            {{> "systems/shadowbase/templates/partials/abilities/actor-abilities.hbs" abilities=system.abilities}}
        </div>

        {{!-- Inventory Tab --}}
        <div class="tab" data-group="primary" data-tab="inventory">
            {{> "systems/shadowbase/templates/partials/inventory/actor-inventory.hbs" inventory=system.inventory}}
            {{> "systems/shadowbase/templates/partials/inventory/actor-weapons-list.hbs" inventory=system.inventory}}
            {{> "systems/shadowbase/templates/partials/inventory/actor-vehicles.hbs" inventory=system.inventory}}
        </div>

        {{!-- Narrative Tab --}}
        <div class="tab" data-group="primary" data-tab="narrative">
            {{> "systems/shadowbase/templates/partials/narriative/actor-notes.hbs" narrative=system.narrative}}
        </div>

    </section>
</form>