{{!-- templates/chat/target-roll.hbs - one 3d6 against a target (use-dice-roller.ts rollTargetNumber's lines:
     Skill / Target / Rolled [d, d, d] / Result). Context: module/rolls.mjs rollTarget. --}}
<div class="shadowbase sb-chat-card sb-chat-card--target {{#if success}}is-success{{else}}is-failure{{/if}}{{#if critical}} is-critical{{/if}}{{#if malfunction}} is-malfunction{{/if}}" data-actor-id="{{actorId}}"{{#if itemId}} data-item-id="{{itemId}}"{{/if}}>
  <header class="sb-chat-card__header">
    <h3 class="sb-chat-card__title">{{title}}</h3>
    {{#if skillType}}<span class="sb-badge sb-badge-outline sb-chat-card__badge" title="{{skillNote}}">{{skillType}}</span>{{/if}}
  </header>
  <dl class="sb-chat-card__lines">
    {{#if skillName}}<dt>{{localize "SHADOWBASE.Roll.Skill"}}</dt><dd>{{skillName}}</dd>{{/if}}
    <dt>{{localize "SHADOWBASE.Roll.Target"}}</dt><dd><strong>{{target}}</strong>{{#if modifierText}} <span class="sb-chat-card__muted">({{baseTarget}} {{modifierText}})</span>{{/if}}</dd>
    <dt>{{localize "SHADOWBASE.Roll.Rolled"}}</dt><dd><strong>{{total}}</strong> <span class="sb-chat-card__dice">[{{diceText}}]</span></dd>
    <dt>{{localize "SHADOWBASE.Roll.Result"}}</dt>
    <dd class="sb-chat-card__result">{{#each result.lines}}<span class="sb-chat-card__result-line">{{this}}</span>{{/each}}</dd>
  </dl>
  {{#if breakdown.length}}
  <ul class="sb-chat-card__breakdown">
    {{#each breakdown}}<li><span>{{this.label}}</span><span class="sb-chat-card__value">{{this.value}}</span></li>{{/each}}
  </ul>
  {{/if}}
  {{#if malfunctionThreshold}}<p class="sb-chat-card__muted">{{localize "SHADOWBASE.Roll.MalfLine" malf=malfunctionThreshold}}</p>{{/if}}
  {{#if flawedItem}}<p class="sb-chat-card__muted">{{localize "SHADOWBASE.Roll.FlawedItem"}}</p>{{/if}}
  {{#if caveat}}<p class="sb-chat-card__muted">{{caveat}}</p>{{/if}}
  {{#if advisories.length}}
  <div class="sb-chat-card__advisories">
    {{#each advisories}}<p class="sb-chat-card__advisory"><strong>{{this.label}}:</strong> {{this.detail}}</p>{{/each}}
  </div>
  {{/if}}
  {{#if canRollDamage}}{{#if success}}
  <footer class="sb-chat-card__actions">
    <button type="button" class="sb-btn sb-btn-destructive sb-btn-sm" data-action="roll-damage"><i class="fa-solid fa-burst"></i> {{localize "SHADOWBASE.Roll.RollDamage"}}</button>
  </footer>
  {{/if}}{{/if}}
</div>
