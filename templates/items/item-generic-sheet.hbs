<!-- systems\shadowbase\templates\items\item-generic-sheet.hbs -->

<form class="{{cssClass}}" autocomplete="off">

    {{!-- Sheet Header --}}
    <header class="sheet-header item-sheet-header">
        <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
        <div class="header-fields">
            <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Item Name"/></h1>
        </div>
    </header>

    {{!-- Sheet Body --}}
    <section class="sheet-body">

        {{log system}}

        {{!-- Display all System Properties --}}
        <div class="system-properties">
            <h2>System Data</h2>
            {{#each system as |value key|}}
                <div class="form-group">
                    <label>{{key}}:</label>
                    <input type="text" value="{{value}}" disabled/>
                </div>
            {{/each}}
        </div>

        {{!-- Existing Fields (Optional - you can remove these if they are redundant with the system data display) --}}
        {{!--
        <div class="form-group">
            <label for="system.points">Points</label>
            <input type="number" id="system.points" name="system.points" value="{{system.points}}" placeholder="0" />
        </div>

        <div class="form-group form-group-full">
            <label for="system.notes">Description / Notes</label>
            <textarea id="system.notes" name="system.notes" rows="8" placeholder="Enter description, effects, and notes here.">{{system.notes}}</textarea>
        </div>
        --}}

    </section>

</form>