<!-- systems\shadowbase\templates\partials\core\actor-secondary-stats.hbs -->

<div class="section-box">
    <h3 class="section-header">Secondary Characteristics</h3>
    <div class="secondary-stats-grid">
        {{!-- Will --}}
        <div class="attribute-block">
            <label class="attribute-label">Will</label>
            <div class="attribute-value-wrapper">
                <input type="number" name="system.characteristics.will.final" value="{{system.characteristics.will.final}}" class="attribute-value-input" />
                <button type="button" class="roll-button" data-roll-type="attribute" data-roll-key="will">
                    <i class="fas fa-dice-d20"></i>
                </button>
            </div>
        </div>
        {{!-- Perception --}}
        <div class="attribute-block">
            <label class="attribute-label">Perception</label>
            <div class="attribute-value-wrapper">
                <input type="number" name="system.characteristics.perception.final" value="{{system.characteristics.perception.final}}" class="attribute-value-input" />
                <button type="button" class="roll-button" data-roll-type="attribute" data-roll-key="perception">
                    <i class="fas fa-dice-d20"></i>
                </button>
            </div>
        </div>
        {{!-- Vision --}}
        <div class="attribute-block">
            <label class="attribute-label">Vision</label>
            <div class="attribute-value-wrapper">
                <input type="number" name="system.characteristics.vision.final" value="{{system.characteristics.vision.final}}" class="attribute-value-input" />
                <button type="button" class="roll-button" data-roll-type="attribute" data-roll-key="vision">
                    <i class="fas fa-dice-d20"></i>
                </button>
            </div>
        </div>
        {{!-- Hearing --}}
        <div class="attribute-block">
            <label class="attribute-label">Hearing</label>
            <div class="attribute-value-wrapper">
                <input type="number" name="system.characteristics.hearing.final" value="{{system.characteristics.hearing.final}}" class="attribute-value-input" />
                <button type="button" class="roll-button" data-roll-type="attribute" data-roll-key="hearing">
                    <i class="fas fa-dice-d20"></i>
                </button>
            </div>
        </div>
        {{!-- Taste & Smell --}}
        <div class="attribute-block">
            <label class="attribute-label">Taste & Smell</label>
            <div class="attribute-value-wrapper">
                <input type="number" name="system.characteristics.tasteAndSmell.final" value="{{system.characteristics.tasteAndSmell.final}}" class="attribute-value-input" />
                <button type="button" class="roll-button" data-roll-type="attribute" data-roll-key="tasteAndSmell">
                    <i class="fas fa-dice-d20"></i>
                </button>
            </div>
        </div>
        {{!-- Touch --}}
        <div class="attribute-block">
            <label class="attribute-label">Touch</label>
            <div class="attribute-value-wrapper">
                <input type="number" name="system.characteristics.touch.final" value="{{system.characteristics.touch.final}}" class="attribute-value-input" />
                <button type="button" class="roll-button" data-roll-type="attribute" data-roll-key="touch">
                    <i class="fas fa-dice-d20"></i>
                </button>
            </div>
        </div>
        {{!-- Fright Check --}}
        <div class="attribute-block">
            <label class="attribute-label">Fright Check</label>
            <div class="attribute-value-wrapper">
                <input type="number" name="system.characteristics.frightCheck.final" value="{{system.characteristics.frightCheck.final}}" class="attribute-value-input" />
                <button type="button" class="roll-button" data-roll-type="attribute" data-roll-key="frightCheck">
                    <i class="fas fa-dice-d20"></i>
                </button>
            </div>
        </div>

        {{!-- Basic Speed --}}
        <div class="attribute-block">
            <label class="attribute-label">Basic Speed</label>
            <div class="attribute-value-wrapper">
                <input type="text" name="system.characteristics.basicSpeed.final" value="{{system.characteristics.basicSpeed.final}}" class="attribute-value-input" />
            </div>
        </div>
        {{!-- Basic Move --}}
        <div class="attribute-block">
            <label class="attribute-label">Basic Move</label>
            <div class="attribute-value-wrapper">
                <input type="number" name="system.characteristics.basicMove.final" value="{{system.characteristics.basicMove.final}}" class="attribute-value-input" />
            </div>
        </div>
        {{!-- Basic Lift --}}
        <div class="attribute-block">
            <label class="attribute-label">Basic Lift</label>
            <div class="attribute-value-wrapper">
                <input type="text" value="{{system.characteristics.basicLift}}" readonly class="attribute-value-input" />
            </div>
        </div>
        {{!-- Damage (Thrust) --}}
        <div class="attribute-block">
            <label class="attribute-label">Dmg (Thrust)</label>
            <div class="attribute-value-wrapper">
                <input type="text" value="{{system.characteristics.damage.thrust}}" readonly class="attribute-value-input" />
            </div>
        </div>
        {{!-- Damage (Swing) --}}
        <div class="attribute-block">
            <label class="attribute-label">Dmg (Swing)</label>
            <div class="attribute-value-wrapper">
                <input type="text" value="{{system.characteristics.damage.swing}}" readonly class="attribute-value-input" />
            </div>
        </div>
    </div>
</div>