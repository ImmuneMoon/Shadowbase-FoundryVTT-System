<!-- systems\shadowbase\templates\partials\combat\combat-hub-defenses.hbs -->

<div class="section-box">
  <h4 class="font-semibold text-primary">Defenses & Maneuvers</h4>
  <div class="grid grid-cols-3 gap-2 mt-1">
      <div class="resource-item">
          <label class="text-xs">Dodge</label>
          <input type="number" value="{{system.characteristics.defenses.dodge}}" readonly class="bg-muted/50 font-bold text-center" />
      </div>
      <div class="resource-item">
          <label class="text-xs truncate" title="{{activeParrySkillName}}">Parry {{#if activeParrySkillName}}({{substring activeParrySkillName 0 10}}...){{/if}}</label>
          <input type="number" value="{{system.characteristics.defenses.parry}}" readonly class="bg-muted/50 font-bold text-center" />
      </div>
      <div class="resource-item">
          <label class="text-xs truncate" title="{{activeBlockSkillName}}">Block {{#if activeBlockSkillName}}({{substring activeBlockSkillName 0 10}}...){{/if}}</label>
          <input type="number" value="{{system.characteristics.defenses.block}}" readonly class="bg-muted/50 font-bold text-center" />
      </div>
      <div class="maneuver-toggle">
        <label for="aim-toggle" class="text-xs">Aim</label>
        <div class="toggle-container">
            <input type="checkbox" id="aim-toggle" name="system.maneuvers.aim" {{checked system.maneuvers.aim}} />
        </div>
      </div>
      <div class="maneuver-toggle">
        <label for="all-out-defense-toggle" class="text-xs">All-Out Defense</label>
        <div class="toggle-container">
            <input type="checkbox" id="all-out-defense-toggle" name="system.maneuvers.allOutDefense" {{checked system.maneuvers.allOutDefense}} />
        </div>
      </div>
  </div>
</div>
