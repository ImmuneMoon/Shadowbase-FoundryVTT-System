{{!-- templates/actor/parts/technique-row.hbs - one combat technique row (combat-techniques-section.tsx 385-560: name, Tier select,
     CP Cost, Points (Calculated), EP Cost, base skill / tier / FP cost, weapon selector, roll, apply costs). Context: a techniqueRow. --}}
<li class="sb-row sb-technique-row" data-item-id="{{id}}">
  <div class="sb-row__main">
    <input type="text" class="sb-input sb-row__name" name="items.{{id}}.row.name" value="{{rowName}}" placeholder="{{localize "SHADOWBASE.Sheet.Abilities.TechniqueName"}}" {{disabled (not @root.editable)}}>
    <select class="sb-select sb-select--sm" name="items.{{id}}.row.level" data-dtype="Number" title="{{localize "SHADOWBASE.Sheet.Abilities.Tier"}}" {{disabled (not @root.editable)}}>
      {{#each levels}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
    {{#if tier}}<span class="sb-badge sb-badge-secondary">{{tier}}</span>{{/if}}
    <input type="number" class="sb-input sb-input--tiny" name="items.{{id}}.row.cpCost" value="{{cpCost}}" data-dtype="Number" title="{{localize "SHADOWBASE.Sheet.Abilities.CpCost"}}" {{disabled (not @root.editable)}}>
    <output class="sb-input sb-input--calc sb-calc" title="{{localize "SHADOWBASE.Sheet.Abilities.PointsCalculated"}}">{{effective}}</output>
    <span class="sb-badge sb-badge-outline" title="{{localize "SHADOWBASE.Sheet.Abilities.FpEpCosts"}}">{{epCost}} EP{{#if fpCost}} · {{fpCost}} FP{{/if}}</span>
    {{#if damageBonus}}<span class="sb-badge sb-badge-outline sb-badge--effect sb-badge--pos">{{localize "SHADOWBASE.Sheet.Abilities.DamageBonus" n=damageBonus}}</span>{{/if}}
    {{#if skillBonus}}<span class="sb-badge sb-badge-outline sb-badge--effect sb-badge--pos">+{{skillBonus}} {{localize "SHADOWBASE.Sheet.Abilities.Skill"}}</span>{{/if}}
    {{#if skillPenalty}}<span class="sb-badge sb-badge-outline sb-badge--effect sb-badge--neg">-{{skillPenalty}} {{localize "SHADOWBASE.Sheet.Abilities.Skill"}}</span>{{/if}}
    <span class="sb-row-tools">
      <button type="button" class="sb-btn sb-btn-ghost sb-btn-icon" data-action="openItem" data-item-id="{{id}}" title="{{localize "SHADOWBASE.Sheet.OpenSheet"}}"><i class="fa-solid fa-up-right-from-square"></i></button>
      <button type="button" class="sb-btn sb-btn-ghost sb-btn-icon sb-danger" data-action="deleteItem" data-item-id="{{id}}" title="{{localize "SHADOWBASE.Sheet.Delete"}}" {{disabled (not @root.editable)}}><i class="fa-solid fa-xmark"></i></button>
    </span>
  </div>
  <div class="sb-row__sub sb-row__roll">
    <span class="sb-muted">{{localize "SHADOWBASE.Sheet.Abilities.BaseSkill"}}: {{#if baseSkill}}{{baseSkill}}{{else}}—{{/if}}</span>
    {{#if needsWeapon}}
    <select class="sb-select sb-select--sm" name="items.{{id}}.row.selectedWeaponId" title="{{localize "SHADOWBASE.Sheet.Abilities.SelectWeapon"}}" {{disabled (not @root.editable)}}>
      {{#each weapons}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
    {{/if}}
    <button type="button" class="sb-btn sb-btn-outline sb-btn-sm" data-action="rollTechnique" data-item-id="{{id}}" {{disabled (not target)}} title="{{#if target}}{{localize "SHADOWBASE.Sheet.Abilities.RollTechnique" target=target skill=targetSkill}}{{else}}{{localize "SHADOWBASE.Sheet.Abilities.NoTechniqueTarget"}}{{/if}}"><i class="fa-solid fa-dice"></i> {{#if target}}{{target}}{{else}}—{{/if}}</button>
    <button type="button" class="sb-btn sb-btn-outline sb-btn-sm sb-accent" data-action="applyTechniqueCosts" data-item-id="{{id}}" {{disabled (not hasCosts)}} title="{{localize "SHADOWBASE.Sheet.Abilities.ApplyCosts" fp=fpCost ep=epCost}}"><i class="fa-solid fa-bolt"></i></button>
  </div>
  <details class="sb-row__details">
    <summary>{{localize "SHADOWBASE.Sheet.Abilities.Effect"}}</summary>
    <textarea class="sb-textarea" name="items.{{id}}.row.effect" rows="2" {{disabled (not @root.editable)}}>{{effect}}</textarea>
  </details>
</li>
