{{!-- templates/actor/parts/power-row.hbs - one Force power row (force-powers-section.tsx 180-262: name, Level select,
     CP Cost, Points (Calculated), roll, Apply Costs (-FP, -EP); tier / alignment / base skill). Context: a powerRow. --}}
<li class="sb-row sb-power-row" data-item-id="{{id}}">
  <div class="sb-row__main">
    <input type="text" class="sb-input sb-row__name" name="items.{{id}}.row.name" value="{{rowName}}" placeholder="{{localize "SHADOWBASE.Sheet.Abilities.PowerName"}}" {{disabled (not @root.editable)}}>
    <select class="sb-select sb-select--tiny" name="items.{{id}}.row.level" data-dtype="Number" title="{{localize "SHADOWBASE.Sheet.Abilities.Level"}}" {{disabled (not @root.editable)}}>
      {{#each levels}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
    {{#if tier}}<span class="sb-badge sb-badge-secondary">{{tier}}</span>{{/if}}
    {{#if alignment}}<span class="sb-badge sb-badge-outline sb-align-{{alignment}}">{{alignment}}</span>{{/if}}
    <input type="number" class="sb-input sb-input--tiny" name="items.{{id}}.row.cpCost" value="{{cpCost}}" data-dtype="Number" title="{{localize "SHADOWBASE.Sheet.Abilities.CpCost"}}" {{disabled (not @root.editable)}}>
    <output class="sb-input sb-input--calc sb-calc" title="{{localize "SHADOWBASE.Sheet.Abilities.PointsCalculated"}}">{{effective}}</output>
    <span class="sb-badge sb-badge-outline" title="{{localize "SHADOWBASE.Sheet.Abilities.FpEpCosts"}}">{{fpCost}} FP · {{epCost}} EP</span>
    <button type="button" class="sb-btn sb-btn-outline sb-btn-icon" data-action="rollPower" data-item-id="{{id}}" {{disabled (not target)}} title="{{#if target}}{{localize "SHADOWBASE.Sheet.Abilities.RollPower" target=target skill=targetSkill}}{{else}}{{localize "SHADOWBASE.Sheet.Abilities.NoDefault" skill=baseSkill}}{{/if}}"><i class="fa-solid fa-dice"></i></button>
    <button type="button" class="sb-btn sb-btn-outline sb-btn-icon sb-accent" data-action="applyPowerCosts" data-item-id="{{id}}" {{disabled (not inCatalog)}} title="{{localize "SHADOWBASE.Sheet.Abilities.ApplyCosts" fp=fpCost ep=epCost}}"><i class="fa-solid fa-bolt"></i></button>
    <span class="sb-row-tools">
      <button type="button" class="sb-btn sb-btn-ghost sb-btn-icon" data-action="openItem" data-item-id="{{id}}" title="{{localize "SHADOWBASE.Sheet.OpenSheet"}}"><i class="fa-solid fa-up-right-from-square"></i></button>
      <button type="button" class="sb-btn sb-btn-ghost sb-btn-icon sb-danger" data-action="deleteItem" data-item-id="{{id}}" title="{{localize "SHADOWBASE.Sheet.Delete"}}" {{disabled (not @root.editable)}}><i class="fa-solid fa-xmark"></i></button>
    </span>
  </div>
  <p class="sb-muted sb-row__sub">
    <span>{{localize "SHADOWBASE.Sheet.Abilities.BaseSkill"}}: {{#if baseSkill}}{{baseSkill}}{{else}}—{{/if}}</span>
    {{#if requirements}}<span> · {{localize "SHADOWBASE.Sheet.Abilities.Requires"}}: {{requirements}}</span>{{/if}}
    {{#if category}}<span> · {{category}}</span>{{/if}}
    {{#if describe}}<span> · {{describe}}</span>{{/if}}
  </p>
  <details class="sb-row__details">
    <summary>{{localize "SHADOWBASE.Sheet.Abilities.Effect"}}</summary>
    <textarea class="sb-textarea" name="items.{{id}}.row.effect" rows="2" {{disabled (not @root.editable)}}>{{effect}}</textarea>
    {{#if description}}<p class="sb-dossier">{{description}}</p>{{/if}}
  </details>
</li>
