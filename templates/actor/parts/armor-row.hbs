{{!-- templates/actor/parts/armor-row.hbs - one Armor & Clothing row (armor-item-card.tsx 585-680: name, condition badge, DR badge,
     x qty, Poor Fit, shield Active toggle, Equipped toggle). Context: an armorRow. --}}
<li class="sb-row sb-armor-row{{#if equipped}} is-equipped{{/if}}" data-item-id="{{id}}">
  <div class="sb-row__main">
    <img class="sb-row__icon" src="{{img}}" alt="">
    <input type="text" class="sb-input sb-row__name" name="items.{{id}}.row.name" value="{{rowName}}" {{disabled (not @root.editable)}}>
    {{#if armorType}}<span class="sb-muted">{{armorType}}</span>{{/if}}
    <span class="sb-badge sb-badge-outline sb-badge-accent sb-mono" data-armor-dr title="{{drNotes}}">DR {{drText}}</span>
    {{#if quantity}}{{#if (gt quantity 1)}}<span class="sb-badge sb-badge-secondary sb-badge--count">×{{quantity}}</span>{{/if}}{{/if}}
    <span class="sb-badge {{#if condition.fine}}sb-badge-outline{{else}}sb-badge-destructive{{/if}}">{{condition.text}}</span>
    {{#if setName}}<span class="sb-badge sb-badge-secondary" title="{{localize "SHADOWBASE.Sheet.Inventory.SetMember"}}"><i class="fa-solid fa-layer-group"></i> {{setName}}</span>{{/if}}
    {{#if sealed}}<span class="sb-badge sb-badge-outline">{{localize "SHADOWBASE.Sheet.Inventory.Sealed"}}</span>{{/if}}
    {{#if movePenalty}}<span class="sb-badge sb-badge-outline sb-badge--effect sb-badge--neg">{{movePenalty}} {{localize "SHADOWBASE.Sheet.Channel.Move"}}</span>{{/if}}
    {{#if dxPenalty}}<span class="sb-badge sb-badge-outline sb-badge--effect sb-badge--neg">{{dxPenalty}} {{localize "SHADOWBASE.Sheet.Channel.DX"}}</span>{{/if}}
    <span class="sb-muted sb-mono">{{weight}} lb · {{cost}} cr</span>
    {{#if isShield}}
    <button type="button" class="sb-btn sb-btn-sm {{#if isActive}}sb-btn-default{{else}}sb-btn-outline{{/if}}" data-action="toggleActive" data-item-id="{{id}}" {{disabled (not @root.editable)}}><i class="fa-solid fa-shield"></i> {{#if isActive}}{{localize "SHADOWBASE.Sheet.Inventory.ShieldActive"}}{{else}}{{localize "SHADOWBASE.Sheet.Inventory.ShieldInactive"}}{{/if}}</button>
    {{/if}}
    <button type="button" class="sb-btn sb-btn-sm {{#if equipped}}sb-btn-default{{else}}sb-btn-outline{{/if}}" data-action="toggleEquipped" data-item-id="{{id}}" {{disabled (not @root.editable)}}><i class="fa-solid fa-shirt"></i> {{#if equipped}}{{localize "SHADOWBASE.Sheet.Inventory.Equipped"}}{{else}}{{localize "SHADOWBASE.Sheet.Inventory.Equip"}}{{/if}}</button>
    {{> "systems/shadowbase/templates/actor/parts/row-tools.hbs" id=id storage=storage kind=kind editable=@root.editable}}
  </div>
  {{#if coverage.length}}<p class="sb-muted sb-row__sub">{{localize "SHADOWBASE.Sheet.Inventory.Covers"}}: {{#each coverage}}<span class="sb-tag sb-tag--muted">{{this}}</span>{{/each}}</p>{{/if}}
  {{#if notesAndEffects}}<p class="sb-muted sb-row__sub">{{notesAndEffects}}</p>{{/if}}
</li>
