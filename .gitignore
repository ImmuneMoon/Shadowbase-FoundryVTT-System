# Tooling
node_modules/

# Compendia. `npm run build` regenerates the sources from the engine on every build and compiles them;
# a release zip carries the compiled packs/, git carries neither.
packs/
packs-src/

# Machine-local settings (tools/website-path.mjs reads the website checkout's path from website-path.local.json)
*.local.json

# The retired 2025 system, kept on disk for reference; git history holds it
_husk/

# The maintainer's working documents (design notes, build log, test script). Only the changelog is published.
docs/*
!docs/CHANGELOG.md

# Scratch
*.log
.DS_Store
Thumbs.db

# Preview renders (tools/render-preview.mjs, render-tabs-preview.mjs, render-hud.mjs, render-apps.mjs default output)
preview/
