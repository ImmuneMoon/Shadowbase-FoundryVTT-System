{
  "name": "shadowbase-foundryvtt-system",
  "version": "2.0.0",
  "private": true,
  "description": "Foundry VTT v13 system for Shadows of the Mandalorian War (ShadowBase). Rules, catalogs and migrations are bundled from the ShadowBase website's own engine; nothing here re-implements a rule.",
  "type": "module",
  "scripts": {
    "build:engine": "node tools/build-engine.mjs",
    "build:packs": "node tools/build-packs.mjs",
    "build:handbook": "node tools/build-handbook-pack.mjs",
    "build": "node tools/build-engine.mjs && node tools/build-handbook-pack.mjs && node tools/build-packs.mjs",
    "check:all": "node scripts/check-all.mjs",
    "check:engine-parity": "node scripts/check-engine-parity.mjs",
    "check:actor-schema": "node scripts/check-actor-schema.mjs",
    "check:adapter-round-trip": "node scripts/check-adapter-round-trip.mjs",
    "check:derived-not-stored": "node scripts/check-derived-not-stored.mjs",
    "check:effects": "node scripts/check-effects.mjs",
    "check:esm": "node scripts/check-esm.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:packs": "node scripts/check-packs.mjs",
    "check:handbook": "node scripts/check-handbook.mjs",
    "check:rolls": "node scripts/check-rolls.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "check:sheet-tabs": "node scripts/check-sheet-tabs.mjs",
    "check:json-contract": "node scripts/check-json-contract.mjs",
    "check:hud": "node scripts/check-hud.mjs",
    "check:item-sheets": "node scripts/check-item-sheets.mjs",
    "check:apps": "node scripts/check-apps.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "preview:sheet": "node tools/render-preview.mjs",
    "preview:tabs": "node tools/render-tabs-preview.mjs",
    "preview:hud": "node tools/render-hud.mjs",
    "preview:item": "node tools/render-preview.mjs --item all",
    "preview:apps": "node tools/render-apps.mjs --all",
    "preview:settings": "node tools/render-preview.mjs --settings",
    "preview:all": "node tools/render-preview.mjs --template rokarr && node tools/render-preview.mjs --fixture export-sahrhie-vosst-2026-09-06.json && node tools/render-preview.mjs --tabs && node tools/render-preview.mjs --hud --all && node tools/render-preview.mjs --item all && node tools/render-preview.mjs --app --all && node tools/render-preview.mjs --settings",
    "fold:i18n": "node tools/fold-i18n-requests.mjs",
    "smoke:data-layer": "node tools/smoke-data-layer.mjs",
    "gen:actor-schema": "node tools/gen-actor-schema.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "esbuild": "0.28.2",
    "handlebars": "^4.7.9"
  }
}
