        "category": "Mental",
        "cost": -5
      },
      {
        "name": "Paranoia",
        "points": -10,
        "level": null,
        "description": "The character suffers from irrational distrust and suspicion of others. This can lead to misjudgments, strained alliances, and an inability to trust even legitimate offers of help, making you isolated.",
