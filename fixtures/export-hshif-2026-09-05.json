      },
      {
        "name": "Force Sensitive",
        "points": 5,
        "level": null,
        "description": "You can feel the Force. Purchasing this advantage is the prerequisite for learning all Apprentice-tier Force Powers. You must purchase this advantage before buying anything else related to the Force (Force Powers, Force Training, Force Talents, Force skills, and other Force Advantages). You can only take this advantage at character creation – your character is either Force Sensitive or not. Taking this advantage does not necessarily mean your character is aware of their abilities. This advantage also grants access to more exotic advantages normally only available in racial templates; these are subject to the \"-Force\" limitation, costing 10% less than normal. This is the foundational ability to tap into the galaxy's ultimate power, which can be bent to any will.",
        "baselinePoints": 0,
        "category": "Force",
        "cost": 5
      },
      {
        "name": "Force Training",
        "points": 10,
        "level": 1,
        "description": "Force Training 1 (Adept). Benefit: You unlock the ability to learn Adept tier Force Powers. You also gain a permanent +1 bonus to your maximum Force Points (FP).",
        "baselinePoints": 0,
        "category": "Force",
        "cost": 10
      },
      {
        "name": "Weapon Master",
        "points": 20,
        "level": 1,
        "description": "Single weapon (e.g., Lightsaber)",
        "baselinePoints": 0,
        "category": "Physical",
        "cost": 20
      },
      {
        "name": "Literacy",
        "points": 10,
        "level": null,
        "description": "You can read and write in your native language. A basic necessity for understanding galactic politics, decrypting intelligence, or forging documents.",
        "baselinePoints": 0,
        "category": "Social/Wealth",
        "cost": 10
      },
      {
        "name": "High Pain Threshold",
        "points": 10,
        "level": null,
        "description": "You are unusually resistant to the effects of pain, suffering fewer penalties from injury. Allows you to endure torture or continue fighting effectively even when severely wounded, a vital trait for a survivor in a brutal war.",
        "baselinePoints": 0,
        "category": "Mental",
        "cost": 10
      }
    ],
